# 上传模板：API Key 已留空，请在本机填入真实值。
# 注意：含真实 Key 的改动不要 commit；可用 git update-index --skip-worktree .env 忽略本地改动。

# 独立站点发布配置：发布时只会上传本目录，不会带上上级目录（美甲站）的 .env，
# 所以这里必须自带生图服务配置。不要把 .env 提交到 git 或发给别人。

OPENAI_API_KEY=
OPENAI_BASE_URL=https://newapi.dragon3api.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2
OUTPUT_FORMAT=jpeg
REQUEST_TIMEOUT_MS=240000
MAX_CONCURRENT=3
MOCK_MODE=0

# 访问口令（留空则不设防，公开链接任何人都能消耗额度）
ACCESS_CODE=

# PORT / STUDIO_PORT / STUDIO_HOST 故意不写：发布平台注入 PORT，本地则用默认 3001 / 127.0.0.1
