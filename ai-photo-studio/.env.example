# 本工作台默认直接复用上级目录（美甲站）.env 里的生图配置：
#   OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_IMAGE_MODEL / HTTPS_PROXY
# 所以一般不需要新建 .env。只有想单独换 Key、换端口时，才复制本文件为 .env 并填写（这里的值会覆盖上级）。
# 不要把 .env 提交到 git 或发给别人。

# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_IMAGE_MODEL=gpt-image-2

# 端口与监听地址（与美甲站 3000 错开）
STUDIO_PORT=3001
STUDIO_HOST=127.0.0.1

# 访问口令（可选）
ACCESS_CODE=

# 单次生图超时（毫秒）；服务端同时生图的上限（前端默认同时跑 2 张）
REQUEST_TIMEOUT_MS=240000
MAX_CONCURRENT=3

# 设为 1 强制使用模拟模式
MOCK_MODE=0
