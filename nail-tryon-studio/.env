# 上传模板：API Key 已留空，请在本机填入真实值。
# 注意：含真实 Key 的改动不要 commit；可用 git update-index --skip-worktree .env 忽略本地改动。

# 复制本文件为 .env 后填写。不要把 .env 提交到 git 或发给别人。

# OpenAI API Key（必填；不填则进入模拟模式，只返回原图用于测试流程）
OPENAI_API_KEY=

# 生图模型，默认 gpt-image-2（GPT-Image 2.0）。以后有新版本直接改这里
OPENAI_IMAGE_MODEL=gpt-image-2

# 接口地址。直连 OpenAI 用默认值；使用兼容 OpenAI 的中转服务时改成对方地址（以 /v1 结尾）
OPENAI_BASE_URL=https://newapi.dragon3api.com/v1

# 服务端口与监听地址。127.0.0.1 仅本机可访问；要让同一 Wi-Fi 下的手机访问，改为 0.0.0.0 并设置 ACCESS_CODE
PORT=3000
HOST=0.0.0.0

# 访问口令（可选）。设置后，网页首次生图时会要求输入，防止别人用你的额度
ACCESS_CODE=

# 单次生图超时（毫秒）和同时生图的最大数量
REQUEST_TIMEOUT_MS=240000
MAX_CONCURRENT=2

# 设为 1 强制使用模拟模式
MOCK_MODE=0
